  "strings": {
    "NSAudioCaptureUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lumora analyzes system audio locally so Music Edge Glow can react to real accents. Audio is never recorded, stored, or uploaded."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Lumora 在本机分析系统音频，让音乐边缘光效跟随节奏变化。音频不会被录制、保存或上传。"
          }
        }
      }
    },
